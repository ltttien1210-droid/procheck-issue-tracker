# Run the README command to generate a random key and paste it here.
SECRET_KEY=

# Windows Authentication, on the local machine only.
DATABASE_BACKEND=mssql
MSSQL_ODBC_CONNECTION='DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=ProCheck;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;'

# Set to 1 when the app is served over HTTPS.
SESSION_COOKIE_SECURE=0
